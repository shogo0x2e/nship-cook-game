{
  "name": "nship-cook-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/server.ts",
    "relay": "ALLOWED_ORIGINS=http://127.0.0.1:5173 node server/server.ts",
    "test": "node --test tests/*.test.ts",
    "setup:pose": "node scripts/setup-pose.mjs",
    "cert:local": "node scripts/create-local-cert.mjs",
    "test:e2e": "node tests/e2e.mjs && node tests/avatar-e2e.mjs",
    "test:avatar": "node tests/avatar-e2e.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
